<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <!-- Solid Deep Navy Background -->
  <rect width="512" height="512" fill="#1e3a8a"/>

  <!-- Vibrant Golden Sun Core -->
  <circle cx="256" cy="256" r="110" fill="#ffd60a"/>

  <!-- Clean, Bold Symmetric Rays -->
  <g stroke="#ffd60a" stroke-width="32" stroke-linecap="round">
    <!-- Cardinal Directions (Up, Down, Left, Right) -->
    <line x1="256" y1="80" x2="256" y2="105"/>
    <line x1="256" y1="407" x2="256" y2="432"/>
    <line x1="80" y1="256" x2="105" y2="256"/>
    <line x1="407" y1="256" x2="432" y2="256"/>

    <!-- Diagonals -->
    <line x1="132" y1="132" x2="150" y2="150"/>
    <line x1="362" y1="362" x2="380" y2="380"/>
    <line x1="132" y1="380" x2="150" y2="362"/>
    <line x1="362" y1="150" x2="380" y2="132"/>
  </g>
</svg>
